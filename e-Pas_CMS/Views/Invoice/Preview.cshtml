@using e_Pas_CMS.ViewModels
@using System.Globalization
@using System.Collections.Generic
@using System.Linq
@model InvoiceDetailViewModel

@{
    Layout = null;

    var claimExpenseAmounts = ViewBag.ClaimExpenseAmounts as Dictionary<string, decimal>
        ?? new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);

    decimal ExpenseAmount(string key)
    {
        return claimExpenseAmounts.TryGetValue(key, out var amount) ? amount : 0m;
    }

    var bpjsKesehatan = ExpenseAmount("BPJS_KESEHATAN");
    var bpjsKetenagakerjaan = ExpenseAmount("BPJS_KETENAGAKERJAAN");
    var vehicleMaintenance = ExpenseAmount("VEHICLE_MAINTENANCE");
    var internetData = ExpenseAmount("INTERNET");
    var others = ExpenseAmount("OTHER");
    var amountDue = Model.TotalExpense - Model.LessDirectCharges - Model.LessAdvances;
    // Pertahankan desain template asli; hanya data baris yang dipaginasi.
    // Maksimal 30 item/lembar. Lembar penutup disisakan ruang untuk bank dan tanda tangan.
    var allPrintLines = (Model.PrintLines ?? new List<InvoicePrintLineVM>())
        .OrderBy(x => x.Date)
        .ThenBy(x => x.Description)
        .ToList();
    var printPages = new List<List<InvoicePrintLineVM>>();
    const int maxRowsPerPage = 30;
    const int preferredFinalRows = 18;
    if (allPrintLines.Count <= maxRowsPerPage)
    {
        printPages.Add(allPrintLines);
    }
    else
    {
        var offset = 0;
        while (allPrintLines.Count - offset > maxRowsPerPage)
        {
            var count = Math.Min(maxRowsPerPage, allPrintLines.Count - offset - preferredFinalRows);
            printPages.Add(allPrintLines.GetRange(offset, count));
            offset += count;
        }
        printPages.Add(allPrintLines.Skip(offset).ToList());
    }

    // Bank, homebase dan ID Auditor berasal dari app_user via InvoiceController.
    // Tampilkan tanda '-' apabila rekening belum diinput.
    var bankAccount = string.IsNullOrWhiteSpace(Model.BankAccount) ? "-" : Model.BankAccount.Trim();
    var bankOwner = bankAccount == "-" ? "-" : (string.IsNullOrWhiteSpace(Model.BankOwner) ? "-" : Model.BankOwner.Trim());
    var bankName = bankAccount == "-" ? "-" : (string.IsNullOrWhiteSpace(Model.BankName) ? "-" : Model.BankName.Trim());
    var autoPrint = ViewBag.AutoPrint is bool ap && ap;
    var claimStatusLabel = ViewBag.ClaimStatusLabel?.ToString() ?? Model.Status;

    string Money(decimal value)
    {
        return value == 0 ? "" : value.ToString("N0", new CultureInfo("id-ID"));
    }

    string Rupiah(decimal value)
    {
        return value == 0 ? "" : "Rp " + Money(value);
    }

    string DateText(DateTime value)
    {
        return value.ToString("dd/MM/yyyy");
    }

    string ApprovalName(int level, string fallback)
    {
        var step = Model.ApprovalSteps?.FirstOrDefault(x => x.ApprovalLevel == level);
        if (step == null)
            return fallback;

        return string.IsNullOrWhiteSpace(step.ApproverName)
            ? step.ApproverUsername
            : step.ApproverName;
    }

    string ApprovalStatus(int level)
    {
        var step = Model.ApprovalSteps?.FirstOrDefault(x => x.ApprovalLevel == level);
        return step?.Status ?? "PENDING";
    }

    string ApprovalDate(int level)
    {
        var step = Model.ApprovalSteps?.FirstOrDefault(x => x.ApprovalLevel == level);
        return step?.ActionDate?.ToString("dd/MM/yyyy") ?? "";
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Preview Invoice - @Model.InvoiceNo</title>
    <style>
            * {
                box-sizing: border-box;
            }

            :root {
                --ink: #111827;
                --line: #111827;
                --muted: #64748b;
                --paper: #ffffff;
                --bg: #eef1f5;
                --yellow: #fff200;
                --cyan: #22b8d4;
            }

            body {
                margin: 0;
                background: var(--bg);
                font-family: Arial, Helvetica, sans-serif;
                color: #000;
            }

            .preview-toolbar {
                width: min(1180px, calc(100% - 32px));
                margin: 16px auto 0;
                display: flex;
                justify-content: flex-end;
                gap: 8px;
            }

            .toolbar-btn {
                border: 0;
                border-radius: 999px;
                padding: 9px 18px;
                background: var(--cyan);
                color: #fff;
                font-weight: 800;
                cursor: pointer;
                text-decoration: none;
                font-size: 12px;
                box-shadow: 0 4px 12px rgba(15, 23, 42, .08);
            }

                .toolbar-btn.dark {
                    background: var(--ink);
                }

            .invoice-sheet {
                width: min(1180px, calc(100% - 32px));
                margin: 12px auto 28px;
                background: var(--paper);
                padding: 24px 26px 28px;
                box-shadow: 0 16px 40px rgba(15, 23, 42, .12);
            }

            .top-header {
                display: grid;
                grid-template-columns: 320px 1fr 255px;
                align-items: center;
                gap: 16px;
                margin-bottom: 14px;
            }

            .company-title {
                font-size: 21px;
                font-weight: 900;
                letter-spacing: -.35px;
            }

            .company-subtitle {
                font-size: 9px;
                margin-top: 3px;
            }

                .company-subtitle strong {
                    font-size: 14px;
                    letter-spacing: -.5px;
                }

            .invoice-heading {
                text-align: center;
                font-size: 26px;
                font-weight: 900;
                letter-spacing: .3px;
            }

            .invoice-meta {
                display: grid;
                gap: 6px;
            }

            .invoice-no-box {
                background: var(--yellow);
                padding: 10px 12px;
                display: grid;
                grid-template-columns: 88px 1fr;
                gap: 7px;
                font-size: 9px;
                font-weight: 900;
            }

            .status-box {
                border: 1px solid #d1d5db;
                padding: 7px 10px;
                display: flex;
                justify-content: space-between;
                gap: 12px;
                font-size: 9px;
            }

                .status-box strong {
                    color: var(--ink);
                }

            .info-block {
                width: 470px;
                margin: 0 0 14px;
            }

            .info-row {
                display: grid;
                grid-template-columns: 105px 1fr;
                align-items: center;
                min-height: 20px;
                font-size: 9px;
                font-weight: 700;
            }

            .info-line {
                border-bottom: 1px solid #111;
                min-height: 18px;
                padding: 3px 7px 2px;
                font-weight: 500;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            .invoice-table {
                table-layout: fixed;
            }

                .invoice-table th,
                .invoice-table td {
                    border: 1px solid var(--line);
                    font-size: 7.6px;
                    padding: 3px 4px;
                    line-height: 1.12;
                    vertical-align: middle;
                }

                .invoice-table th {
                    text-align: center;
                    font-weight: 900;
                    background: #f8fafc;
                }

                .invoice-table td {
                    height: 17px;
                }

                .invoice-table .center {
                    text-align: center;
                }

                .invoice-table .right {
                    text-align: right;
                }

                .invoice-table .bold {
                    font-weight: 900;
                }

                .invoice-table .currency {
                    text-align: right;
                    white-space: nowrap;
                }

                .invoice-table .summary-label {
                    font-weight: 900;
                    text-align: left;
                }

            .after-table {
                display: grid;
                grid-template-columns: 1fr 430px;
                gap: 28px;
                margin-top: 10px;
                align-items: start;
            }

            .notes {
                font-size: 8px;
                line-height: 1.35;
            }

            .notes-block + .notes-block {
                margin-top: 8px;
            }

            .notes strong {
                display: block;
                margin-bottom: 2px;
            }

            .report-statement {
                font-size: 8px;
                line-height: 1.35;
                border-left: 3px solid var(--yellow);
                padding-left: 10px;
            }

            .statement-title {
                font-weight: 900;
                margin-bottom: 3px;
            }

            .bottom-section {
                display: grid;
                grid-template-columns: 350px 1fr;
                gap: 36px;
                margin-top: 18px;
                align-items: start;
            }

            .bank-title {
                font-size: 9px;
                font-weight: 900;
                text-decoration: underline;
                margin-bottom: 7px;
            }

            .bank-table td {
                border: 1px solid #000;
                font-size: 9px;
                height: 20px;
                padding: 3px 6px;
                background: var(--yellow);
            }

            .bank-table .label {
                width: 74px;
                font-weight: 900;
            }

            .sign-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 16px 28px;
            }

            .sign-card {
                border: 1px solid #d1d5db;
                border-radius: 6px;
                padding: 9px 10px;
                min-height: 70px;
            }

            .sign-role {
                font-size: 7.5px;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: .4px;
                margin-bottom: 10px;
                font-weight: 700;
            }

            .sign-name {
                font-size: 9px;
                font-weight: 900;
                padding-bottom: 3px;
                border-bottom: 1px solid #111;
                min-height: 15px;
            }

            .sign-meta {
                display: flex;
                justify-content: space-between;
                gap: 10px;
                margin-top: 5px;
                font-size: 7.5px;
                color: #475569;
            }

            @@media (max-width: 900px) {
                .invoice-sheet,
                .preview-toolbar {
                    width: 1180px;
                }

                body {
                    overflow-x: auto;
                }
            }

            @@media print {
                body {
                    background: #fff;
                }

                .preview-toolbar {
                    display: none;
                }

                .invoice-sheet {
                    width: 100%;
                    margin: 0;
                    padding: 3mm;
                    box-shadow: none;
                    page-break-after: always;
                    break-after: page;
                }

                    .invoice-sheet:last-of-type {
                        page-break-after: auto;
                        break-after: auto;
                    }

                .invoice-footer,
                .after-table,
                .bottom-section,
                .sign-card {
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
                /* Biarkan ringkasan + 'Signed' tetap bersama pada halaman terakhir. */
                .invoice-table th,
                .invoice-table td {
                    padding: 2px 3px;
                    line-height: 1.08;
                    font-size: 7px;
                }

                .invoice-table td {
                    height: 13px;
                }

                .top-header {
                    margin-bottom: 8px;
                }

                .info-block {
                    margin-bottom: 8px;
                }

                .bottom-section {
                    margin-top: 10px;
                }

                .sign-card {
                    min-height: 50px;
                }

                .invoice-sheet-dense .invoice-table th,
                .invoice-sheet-dense .invoice-table td {
                    font-size: 6.6px;
                    padding: 1px 2px;
                }

                .invoice-sheet-dense .invoice-table td {
                    height: 11px;
                }

                .invoice-sheet-dense .after-table {
                    margin-top: 6px;
                }

                .invoice-sheet-dense .bottom-section {
                    margin-top: 6px;
                }

                @@page {
                    size: A4 landscape;
                    margin: 6mm;
                }
            }
    </style>
</head>
<body>
    <div class="preview-toolbar">
        <a asp-action="Detail" asp-route-id="@Model.Id" class="toolbar-btn dark">Back to Detail</a>
        <a asp-action="Export" asp-route-id="@Model.Id" class="toolbar-btn dark">Export Excel</a>
        <button type="button" class="toolbar-btn" onclick="window.print()">Print</button>
    </div>

    @for (var pageIndex = 0; pageIndex < printPages.Count; pageIndex++)
    {
        var pageLines = printPages[pageIndex];
        var isLastPage = pageIndex == printPages.Count - 1;
        var previousLines = printPages.Take(pageIndex).Sum(p => p.Count);
        var rowCount = Math.Max(pageLines.Count, isLastPage ? 12 : 0);
        var sheetClass = isLastPage && pageLines.Count > 20 ? "invoice-sheet invoice-sheet-dense" : "invoice-sheet";

        <div class="@sheetClass">
            <div class="top-header">
                <div>
                    <div class="company-title">PT Citrabuana Indoloka</div>
                    <div class="company-subtitle">In association with <strong>intertek</strong></div>
                </div>

                <div class="invoice-heading">INVOICE</div>

                <div class="invoice-meta">
                    <div class="invoice-no-box">
                        <div>INVOICE NO.</div>
                        <div>: @Model.InvoiceNo</div>
                    </div>
                    <div class="status-box">
                        <span>Status</span>
                        <strong>@claimStatusLabel</strong>
                    </div>
                </div>
            </div>

            <div class="info-block">
                <div class="info-row">
                    <div>Name (Auditor)</div>
                    <div class="info-line">@Model.EmployeeName (ID: @Model.AuditorCode)</div>
                </div>
                <div class="info-row">
                    <div>Period</div>
                    <div class="info-line">@Model.Period</div>
                </div>
                <div class="info-row">
                    <div>Kind of Job</div>
                    <div class="info-line">@Model.Job</div>
                </div>
                <div class="info-row">
                    <div>Homebase</div>
                    <div class="info-line">@Model.Homebase</div>
                </div>
            </div>

            <table class="invoice-table">
                <thead>
                    <tr>
                        <th rowspan="2" style="width:40px;">No</th>
                        <th rowspan="2" style="width:68px;">Date</th>
                        <th rowspan="2" style="width:245px;">Details of Expense</th>
                        <th rowspan="2" style="width:56px;">Cost<br />Centre</th>
                        <th rowspan="2" style="width:96px;">TOTAL EXPENSE</th>
                        <th colspan="7">Descriptions</th>
                    </tr>
                    <tr>
                        <th>Audit Fee</th>
                        <th>Lumpsum</th>
                        <th>BPJS Kesehatan</th>
                        <th>BPJS Ketenagakerjaan</th>
                        <th>Vehicle<br />Maintenance</th>
                        <th>Internet</th>
                        <th>Others</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < rowCount; i++)
                    {
                        var item = i < pageLines.Count ? pageLines[i] : null;
                        <tr>
                            <td class="center">@(item == null ? "" : (previousLines + i + 1).ToString())</td>
                            <td class="center">@(item == null ? "" : DateText(item.Date))</td>
                            <td>@(item == null ? "" : item.Description)</td>
                            <td class="center">@(item == null ? "" : "102")</td>
                            <td class="currency">@(item == null ? "" : Rupiah(item.Total))</td>
                            <td class="currency">@(item == null ? "" : Rupiah(item.AuditFee))</td>
                            <td class="currency">@(item == null ? "" : Rupiah(item.Lumpsum))</td>
                            <td class="currency">@(item == null ? "" : Rupiah(item.BpjsKesehatan))</td>
                            <td class="currency">@(item == null ? "" : Rupiah(item.BpjsKetenagakerjaan))</td>
                            <td class="currency">@(item == null ? "" : Rupiah(item.VehicleMaintenance))</td>
                            <td class="currency">@(item == null ? "" : Rupiah(item.Internet))</td>
                            <td class="currency">@(item == null ? "" : Rupiah(item.Other))</td>
                        </tr>
                    }

                    @if (!isLastPage)
                    {
                        <tr>
                            <td colspan="3" class="summary-label">Continued on next page</td>
                            <td colspan="9" class="right">Page @(pageIndex + 1) of @printPages.Count</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (isLastPage)
            {
                <div class="invoice-footer">
                    <table class="invoice-table invoice-summary-table">
                        <colgroup>
                            <col style="width:3.4%" />
                            <col style="width:5.8%" />
                            <col style="width:21%" />
                            <col style="width:4.8%" />
                            <col style="width:8.2%" />
                            <col style="width:8.1%" />
                            <col style="width:8.1%" />
                            <col style="width:8.1%" />
                            <col style="width:8.1%" />
                            <col style="width:8.1%" />
                            <col style="width:8.1%" />
                            <col style="width:8.2%" />
                        </colgroup>
                        <tbody>
                            <tr>
                                <td colspan="2"></td>
                                <td class="summary-label">Brought forward from continuation sheet</td>
                                <td colspan="9"></td>
                            </tr>
                            <tr>
                                <td colspan="2"></td>
                                <td class="summary-label">TOTAL / CARRIED FORWARD</td>
                                <td></td>
                                <td class="currency bold">@Rupiah(Model.TotalExpense)</td>
                                <td class="currency bold">@Rupiah(Model.TotalAuditFee)</td>
                                <td class="currency bold">@Rupiah(Model.TotalLumpsum)</td>
                                <td class="currency bold">@Rupiah(bpjsKesehatan)</td>
                                <td class="currency bold">@Rupiah(bpjsKetenagakerjaan)</td>
                                <td class="currency bold">@Rupiah(vehicleMaintenance)</td>
                                <td class="currency bold">@Rupiah(internetData)</td>
                                <td class="currency bold">@Rupiah(others)</td>
                            </tr>
                            <tr>
                                <td colspan="2"></td>
                                <td class="summary-label">LESS DIRECT CHARGES</td>
                                <td></td>
                                <td class="currency bold">@Rupiah(Model.LessDirectCharges)</td>
                                <td colspan="7"></td>
                            </tr>
                            <tr>
                                <td colspan="2"></td>
                                <td class="summary-label">LESS ADVANCES</td>
                                <td></td>
                                <td class="currency bold">@Rupiah(Model.LessAdvances)</td>
                                <td colspan="7"></td>
                            </tr>
                            <tr>
                                <td colspan="2"></td>
                                <td class="summary-label">AMOUNT DUE TO/FROM EMPLOYEE</td>
                                <td></td>
                                <td class="currency bold">@(amountDue == 0 ? "Rp 0" : Rupiah(amountDue))</td>
                                <td colspan="7"></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="after-table">
                        <div class="notes">
                            <div class="notes-block">
                                <strong>Claimant</strong>
                                Receipts/invoices for the above are properly documented, attached and cross-referenced.
                            </div>
                            <div class="notes-block">
                                <strong>Accountant / Authoriser</strong>
                                Checked calculations, reasonableness, receipts, dates and supporting documents. Approver may approve or reject the claim.
                            </div>
                        </div>

                        <div class="report-statement">
                            <div class="statement-title">Report Statement</div>
                            The expenses submitted herein are a true and accurate record of prudent costs necessarily incurred on behalf of Intertek.
                            These costs are supported by original receipts wherever possible and have not previously been reimbursed.
                        </div>
                    </div>

                    <div class="bottom-section">
                        <div>
                            <div class="bank-title">Please transfer to:</div>
                            <table class="bank-table">
                                <tr><td class="label">NAME</td><td>@bankOwner</td></tr>
                                <tr><td class="label">Bank</td><td>@bankName</td></tr>
                                <tr><td class="label">A/C No.</td><td>@bankAccount</td></tr>
                            </table>
                        </div>

                        <div class="sign-grid">
                            <div class="sign-card">
                                <div class="sign-role">Requestor</div>
                                <div class="sign-name">@Model.EmployeeName</div>
                                <div class="sign-meta"><span>SUBMITTED</span><span>@Model.ClaimDate.ToString("dd/MM/yyyy")</span></div>
                            </div>
                            <div class="sign-card">
                                <div class="sign-role">Approval Level 1</div>
                                <div class="sign-name">@ApprovalName(1, "tri.handayani")</div>
                                <div class="sign-meta"><span>@ApprovalStatus(1)</span><span>@ApprovalDate(1)</span></div>
                            </div>
                            <div class="sign-card">
                                <div class="sign-role">Approval Level 2</div>
                                <div class="sign-name">@ApprovalName(2, "rommy.irawan")</div>
                                <div class="sign-meta"><span>@ApprovalStatus(2)</span><span>@ApprovalDate(2)</span></div>
                            </div>
                            <div class="sign-card">
                                <div class="sign-role">Approval Level 3</div>
                                <div class="sign-name">@ApprovalName(3, "sabar.kembaren")</div>
                                <div class="sign-meta"><span>@ApprovalStatus(3)</span><span>@ApprovalDate(3)</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (autoPrint)
    {
        <script>
                window.addEventListener('load', function() {
                    window.print();
                });
        </script>
    }
</body>
</html>
